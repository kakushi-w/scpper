# scpper 自己的数据库
DATABASE_URL=postgres://scpper:change-me@127.0.0.1:5432/scpper?sslmode=disable

# pwikit 的数据库，使用只读账号
PWIKIT_DATABASE_URL=postgres://scpper_ro:change-me@127.0.0.1:5432/pwikit?sslmode=disable

# 站点的标识名
PWIKIT_SITE=

# pwikit 数据目录下 [[mount]] 的密钥文件
PWIKIT_SECRET_FILE=/opt/pwikit/secrets/mount-scpper.key

# 监听地址，与 [[mount]] 的 upstream 一致
HTTP_ADDR=127.0.0.1:8100

# 站点地址。填写后，作者被打赏时将收到站内通知
# PWIKIT_URL=https://example.com

# [[mount]] 的 path，默认为 /scpper/
# PWIKIT_MOUNT=/scpper/

# 另外指定一名管理员的用户名。超级管理员无需填写
# BOOTSTRAP_ADMIN=

# 其他分站指数上市时回填行情的起始日期，如 2026-01-01。留空则从建站开始
# CROM_HISTORY_FROM=
